  "principles": [
    {
      "id": "status_quo",
      "name": "Сохранение статус-кво",
      "text": "Сословный порядок кажется естественным. Нарушителя не наказывают напрямую — его перестают приглашать, ему не доверяют, о нём говорят."
    },
    {
      "id": "economic_determinism",
      "name": "Экономический детерминизм",
      "text": "Почти каждое решение упирается в деньги: содержание дома, приданое, наследство, жалованье. Бедность ограничивает выбор сильнее, чем желание."
    },
    {
      "id": "legal_realism",
      "name": "Правовая реальность",
      "text": "Титул, entail и собственность подчиняются законам, а не справедливости. Ошибка в браке или завещании меняет судьбу поколений."
    },
    {
      "id": "social_visibility",
      "name": "Социальная видимость",
      "text": "Всё важное происходит на глазах слуг, соседей и родни. Репутация — общий капитал семьи; скандал одного задевает всех."
    }
  ],
  "rules": [
    {
      "id": "primogeniture",
      "text": "Титул и родовое имение наследует старший сын; младшие сыновья и дочери получают содержание или должны сами пробиваться."
    },
    {
      "id": "entail",
      "text": "Имение закреплено в entail до 1926 года: его нельзя продать или завещать по желанию, оно переходит следующему наследнику мужского пола."
    },
    {
      "id": "chaperonage",
      "text": "Незамужняя женщина из общества не появляется наедине с мужчиной; её сопровождает родственница или компаньонка."
    },
    {
      "id": "no_money_talk_at_table",
      "text": "За столом не обсуждают деньги, политику, религию и болезни. Прямота считается грубостью."
    }
  ],
